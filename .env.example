# Cinch - Local vLLM Serving Configuration
# Target Hardware: NVIDIA RTX 3060 Ti (8GB VRAM)
# Model Target: Qwen2.5-7B-Instruct-AWQ (4-bit AWQ)

# Model configuration
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct-AWQ
QUANTIZATION=awq
DTYPE=half

# Memory budgeting parameters (RTX 3060 Ti 8GB VRAM)
# 0.85 utilization allocates 6.8 GiB (6963.2 MiB) to vLLM, leaving ~1.2GB headroom for display/OS overhead (~450MB-1GB)
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=4096

# Server networking
VLLM_HOST=0.0.0.0
VLLM_PORT=8000

# Container & cache configuration
VLLM_IMAGE=vllm/vllm-openai:latest
HF_CACHE_DIR=~/.cache/huggingface
VLLM_WSL2_ENABLE_PIN_MEMORY=1
